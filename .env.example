# Copie para .env para rodar `npm run local`. Valores batem com o
# `docker compose up` do repo oficina-api (MySQL local com seeds).
AMBIENTE=local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=oficina
DB_USER=root
DB_PASSWORD=root

# Deve ser IGUAL ao JWT_SECRET da API, senão o token é recusado por ela.
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=1h
